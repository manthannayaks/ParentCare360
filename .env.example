# ParentCare360 — Environment Configuration Example
# Copy this file to .env for local overrides: cp .env.example .env

# Server & Network Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Physical SQLite Storage
SQLITE_DB_PATH=data/parentcare360.db
SQLITE_WAL_MODE=true

# Security & Authentication (JWT Secrets)
JWT_SECRET=parentcare360_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client Configuration
VITE_API_URL=http://localhost:8000
# Production Render API: https://parentcare360-api.onrender.com

# External Notification Integrations (Optional / Staged)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@parentcare360.internal
